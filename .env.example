# Configurações do Banco de Dados
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=
DB_HOST=

DATABASE_URL=

# Configurações do Backend
BACKEND_PORT=3000
NODE_ENV=development

# Origens exatas dos frontends, separadas por vírgula (sem barra final)
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Porta lida pelo processo Node; hospedagens podem definir automaticamente
PORT=3000

# Alertas: envio pela API HTTPS do Brevo
EMAIL_ALERTS_ENABLED=false
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=FrotaManager
MAINTENANCE_INTERVAL_KM=10000
MAINTENANCE_WARN_KM=500
# Destinatários: e-mails cadastrados de usuários ativos com manutencoes:ler.
