{
  "name": "frotamanager-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n gestor,motorista -c blue,green \"npm:dev:gestor\" \"npm:dev:motorista\"",
    "dev:gestor": "vite",
    "dev:motorista": "vite --config vite.motorista.config.ts",
    "build": "npm run typecheck && npm run build:gestor && npm run build:motorista",
    "build:gestor": "vite build",
    "build:motorista": "vite build --config vite.motorista.config.ts",
    "preview": "concurrently -n gestor,motorista \"npm:preview:gestor\" \"npm:preview:motorista\"",
    "preview:gestor": "vite preview",
    "preview:motorista": "vite preview --config vite.motorista.config.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "bootstrap": "^5.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
