{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:staged": "jest --passWithNoTests --findRelatedTests",
    "test:push": "jest --passWithNoTests --coverage",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
    "start-server": "tsx src/server.ts",
    "migrate": "dotenv -e ../.env -- node-pg-migrate -j sql -m migrations",
    "migrate:create": "npm run migrate -- create",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "husky:prepare": "husky init",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:push",
    "admin:create": "tsx scripts/create-admin.ts",
    "seed:svo-demo": "tsx scripts/seed-svo-demo.ts",
    "alerts:run": "tsx scripts/run-email-alerts.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "joi": "^18.2.9",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.1.7",
    "nodemon": "^3.1.14",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
